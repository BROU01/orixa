# ORIXA — Variables d'environnement (MODÈLE, ne pas utiliser tel quel)
# Copiez ce fichier en .env.local et remplissez les valeurs.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_EMAIL=admin@2026.fr
NEXT_PUBLIC_SITE_URL=https://maisonlagrace.fr

# Mode démo admin uniquement si Supabase n’est pas configuré.
ADMIN_PASSWORD=
# Générer une valeur aléatoire d’au moins 32 caractères.
ADMIN_SESSION_SECRET=

# Clé "service role" Supabase (Project Settings → API) — SERVEUR UNIQUEMENT,
# jamais préfixée NEXT_PUBLIC_. Nécessaire pour enregistrer réellement les
# commandes, avis et fournisseurs (cf. supabase/schema.sql à exécuter une
# fois dans l'éditeur SQL Supabase avant de renseigner cette clé).
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel — active les e-mails transactionnels (confirmation de commande,
# accusé de réception du formulaire de contact) via https://resend.com.
RESEND_API_KEY=
EMAIL_FROM=MAISON LA GRACE <onboarding@resend.dev>
CONTACT_NOTIFICATION_EMAIL=maroquinerie.lagrace@gmail.com
